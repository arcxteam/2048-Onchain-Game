{
  "name": "2048",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write --ignore-unknown .",
    "preinstall": "npx only-allow pnpm",
    "commit": "git-cz",
    "lint-staged": "lint-staged --config lint-staged.config.cjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "@radix-ui/react-slot": "^1.2.0",
    "@worldcoin/minikit-js": "1.9.6",
    "clsx": "^2.1.1",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "^8.0.5",
    "react-native": "^0.79.4",
    "@tanstack/react-query": "^5.37.1",
    "@metamask/sdk": "0.33.0",
    "@web3auth/modal": "10.0.3",
    "@web3auth/modal-react-hooks": "9.7.0",
    "ethers": "^6.14.4",
    "viem": "^2.28.1",
    "wagmi": "2.14.16",
    "@react-native-async-storage/async-storage": "1.24.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.1",
    "@commitlint/config-conventional": "^17.6.1",
    "@types/node": "20.4.1",
    "@types/prettier": "^2.7.2",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@eslint/eslintrc": "^3",
    "@types/elliptic": "^6.4.14",
    "autoprefixer": "10.4.14",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "8.44.0",
    "eslint-config-next": "15.3.2",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.1",
    "postcss": "8.4.31",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.7",
    "tailwindcss": "3.3.1",
    "typescript": "^5.0.0",
    "crypto-browserify": "3.12.0",
    "stream-browserify": "3.0.0",
    "buffer": "6.0.3",
    "color": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.79.4",
      "@types/react": "19.1.3",
      "@types/react-dom": "19.1.3"
    },
    "peerDependencyRules": {
      "ignoreMissing": ["react-native"],
      "allowedVersions": {
        "react": "19.1.0",
        "react-dom": "19.1.0"
      }
    },
    "onlyBuiltDependencies": [
      "bufferutil",
      "keccak",
      "sharp",
      "tiny-secp256k1",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
