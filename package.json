{
  "name": "2048",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "pnpm install && pnpm add @web3auth/modal @tanstack/react-query viem wagmi",
    "format": "prettier --write --ignore-unknown .",
    "preinstall": "npx only-allow pnpm",
    "commit": "git-cz",
    "lint-staged": "lint-staged --config lint-staged.config.cjs",
    "approve-builds": "pnpm approve-builds"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.80.7",
    "@web3auth/modal": "^10.0.3",
    "clsx": "^2.1.1",
    "ethers": "^6.14.4",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "viem": "^2.31.1",
    "wagmi": "^2.15.6",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@tailwindcss/postcss": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.30",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "postcss": "^8.5.5",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@metamask/sdk": {
      "@react-native-async-storage/async-storage": false
    }
  }
}